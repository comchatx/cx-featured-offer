{
  "name": "@comchatx/cx-featured-offer",
  "version": "0.1.3",
  "description": "Has cx guard your Buy Box and fix what you allow when it's lost.",
  "license": "MIT",
  "author": "ComChatX",
  "comchatx": {
    "about": "让 cx 守住 Buy Box，失去时在你允许的范围内修复，再告诉你。",
    "mark": {
      "line": "target"
    },
    "section": "extensions",
    "order": 54,
    "tryIt": [
      {
        "en": "/featured-offer-guard {asin} If it loses the Buy Box, fix it above my floor price, then tell me in Feishu",
        "zh": "/featured-offer-guard {asin} 失去 Buy Box 时，先在底价以上修复，再通过飞书告诉我。"
      }
    ],
    "needs": [
      "@comchatx/cx-schedule"
    ],
    "builds": [
      "@comchatx/cx-schedule",
      {
        "on": "cx-feishu",
        "need": "optional"
      },
      "cx-listing-playbook",
      "cx-amazon-sp-api",
      {
        "on": "cx-keepa",
        "need": "optional"
      }
    ]
  },
  "homepage": "https://github.com/comchatx/cx-featured-offer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comchatx/cx-featured-offer.git"
  },
  "bugs": "https://github.com/comchatx/cx-featured-offer/issues",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "pi": {
    "prompts": [
      "./prompts"
    ]
  },
  "files": [
    "prompts",
    "README.zh-CN.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@types/node": "26.2.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-mcp": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@earendil-works/pi-codemode": "1.1.0",
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-telemetry": "1.1.0"
  }
}
