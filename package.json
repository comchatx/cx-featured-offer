{
  "name": "@comchatx/cx-featured-offer",
  "version": "0.1.9",
  "description": "Has cx guard your Buy Box and fix what you allow when it's lost.",
  "license": "MIT",
  "author": "ComChatX",
  "comchatx": {
    "name": "Amazon Buy Box Guard",
    "nameZh": "亚马逊 Buy Box 守护",
    "about": "让 cx 守住 Buy Box，失去时在你允许的范围内修复，再告诉你。",
    "mark": {
      "on": "glass",
      "draw": [
        {
          "d": "M2.6 4.2h2.1l2.6 11.2h11.6",
          "width": 1.9
        },
        {
          "d": "M5.3 6.6h16.2l-1.9 6.9H6.9z",
          "rule": "evenodd"
        },
        {
          "d": "M7.3 19.3a1.9 1.9 0 1 1 3.8 0a1.9 1.9 0 1 1 -3.8 0zM15.7 19.3a1.9 1.9 0 1 1 3.8 0a1.9 1.9 0 1 1 -3.8 0z",
          "rule": "evenodd"
        }
      ]
    },
    "section": "extensions",
    "order": 54,
    "needs": [
      "@comchatx/cx-schedule"
    ],
    "builds": [
      "@comchatx/cx-schedule",
      {
        "on": "cx-feishu",
        "need": "optional",
        "why": {
          "en": "Sends each check's result to your Feishu group.",
          "zh": "用于让 cx 把检查结果发到你的飞书群。"
        }
      },
      "cx-listing-playbook",
      "cx-amazon-sp-api",
      {
        "on": "cx-keepa",
        "need": "optional",
        "why": {
          "en": "Lets cx read the Buy Box's history as it looks for why.",
          "zh": "用于让 cx 查原因时也看 Buy Box 的历史。"
        }
      },
      {
        "on": "cx-amazon-seller",
        "need": "optional",
        "why": {
          "en": "Tells cx from the start that you sell on Amazon.",
          "zh": "用于让 cx 从第一条消息起就知道你在亚马逊开店。"
        }
      }
    ],
    "skills": {
      "guard-instruction": {
        "zh": "说明每个 listing 守住 Buy Box 的要求存在哪里，你可以查看和修改。",
        "en": "Where each listing's Buy Box instructions are kept, for you to read and change."
      }
    },
    "prompts": {
      "featured-offer-guard": {
        "zh": "守住【ASIN】的 Buy Box，可以改什么、最低价多少：【要求】"
      }
    }
  },
  "homepage": "https://github.com/comchatx/cx-featured-offer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comchatx/cx-featured-offer.git"
  },
  "bugs": "https://github.com/comchatx/cx-featured-offer/issues",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "pi": {
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "files": [
    "skills",
    "prompts",
    "README.zh-CN.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@types/node": "26.2.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-mcp": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@earendil-works/pi-codemode": "1.1.0",
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-telemetry": "1.1.0"
  }
}
